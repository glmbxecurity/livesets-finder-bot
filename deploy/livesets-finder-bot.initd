#!/sbin/openrc-run

name="livesets-finder-bot"
description="Daemon para LiveSets Finder Telegram Bot"
supervisor="supervise-daemon"

# Rutas de ejecución (modificar según la ubicación en tu sistema)
APP_DIR="/opt/livesets-finder-bot"
command="$APP_DIR/venv/bin/python"
command_args="$APP_DIR/main.py"
command_user="root"
directory="$APP_DIR"

output_log="/var/log/livesets-finder-bot.log"
error_log="/var/log/livesets-finder-bot.err"

depend() {
    need net
    after firewall
}

start_pre() {
    checkpath -f -m 0644 -o "$command_user" "$output_log" "$error_log"
}
